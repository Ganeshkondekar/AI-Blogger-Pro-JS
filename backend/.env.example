TAVILY_API_KEY=your_tavily_api_key_here

# Backend Port (NestJS)
PORT=3001

# PostgreSQL Connection (Optional persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_blogger_pro
